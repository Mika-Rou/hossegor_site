<% content_for :title, "Maison Hossegor — Location saisonnière" %>

<!-- HERO -->
<!-- HERO -->
<section class="relative h-screen overflow-hidden">

  <h1 class="sr-only">
    Thita Hossegor — maison de vacances, lac et centre-ville
  </h1>

  <!-- Photo de la maison -->
  <%= image_tag "thita-accueil.png",
      alt: "Maison de vacances Thita Hossegor avec terrasse",
      class: "absolute inset-0 w-full h-full object-cover object-center" %>

  <!-- Dégradé pour améliorer la lisibilité -->
  <div class="absolute inset-x-0 bottom-0 h-64 bg-gradient-to-t from-black/70 to-transparent"></div>

  <!-- Pictogrammes -->
  <div class="absolute bottom-8 inset-x-0 z-10 px-4 md:px-8 text-white">

    <div class="grid grid-cols-3 md:grid-cols-6 gap-y-6">

      <% atouts = [
        ["store.svg", "Centre-ville & lac", "À moins de 5 min à vélo"],
        ["waves.svg", "Océan", "À moins de 10 min à vélo"],
        ["users.svg", "9 voyageurs", ""],
        ["bed-double.svg", "4 chambres", ""],
        ["shower.svg", "2 salles de bain", ""],
        ["barbecue.svg", "Terrasse &", "barbecue / plancha"]
      ] %>

      <% atouts.each_with_index do |(icone, titre, detail), index| %>

        <div class="flex flex-col items-center text-center px-2 md:px-3
                    <%= index > 0 ? 'md:border-l md:border-white/60' : '' %>">

          <%= image_tag icone,
              alt: "",
              class: "w-9 h-9 md:w-14 md:h-14 mb-3 brightness-0 invert" %>

          <p class="text-[10px] md:text-sm font-semibold uppercase leading-snug">
            <%= titre %>

            <% if detail.present? %>
              <span class="block"><%= detail %></span>
            <% end %>
          </p>

        </div>

      <% end %>

    </div>
  </div>

</section>

<!-- PRESENTATION -->
<section class="container mx-auto px-4 py-4">
  <h2 class="text-justify text-xl md:text-xl font-bold max-w-xl">Notre maison en quelques mots</h2>
  <p>Nous avons entièrement rénové cette maison en 2020 pour en faire un lieu simple, confortable et ouvert sur l’extérieur, parfait pour des vacances à Hossegor.<br>
À 5 minutes du lac et 10 minutes de l’océan à vélo, elle offre 4 chambres, deux salles de bain et une grande terrasse conviviale pour profiter pleinement du soleil et des soirées entre amis ou en famille.</p>
</section>

<!-- ATOUTS -->
<section id="atouts" class="container mx-auto px-4 py-4">
  <h2 class="text-2xl md:text-3xl font-semibold">Les atouts de la maison</h2>
  <div class="mt-8 grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
    <div class="p-6 border rounded-2xl">
      <p class="font-medium">Emplacement</p>
      <p class="text-sm text-gray-600 mt-1">Proche plages, lac, centre d’Hossegor</p>
    </div>
    <div class="p-6 border rounded-2xl">
      <p class="font-medium">Confort</p>
      <p class="text-sm text-gray-600 mt-1">4 chambres, 9 couchages, literie de qualité</p>
    </div>
    <div class="p-6 border rounded-2xl">
      <p class="font-medium">Extérieur</p>
      <p class="text-sm text-gray-600 mt-1">Jardin clos, terrasse, mobilier</p>
    </div>
    <div class="p-6 border rounded-2xl">
      <p class="font-medium">Pratique</p>
      <p class="text-sm text-gray-600 mt-1">Parking privé, local vélos</p>
    </div>
    <div class="p-6 border rounded-2xl">
      <p class="font-medium">Équipements</p>
      <p class="text-sm text-gray-600 mt-1">WiFi, TV, cuisine équipée, lave linge</p>
    </div>
    <div class="p-6 border rounded-2xl">
      <p class="font-medium">Familles</p>
      <p class="text-sm text-gray-600 mt-1">Lit bébé/chaise</p>
    </div>
  </div>
</section>

<!-- GALERIE -->
<section id="galerie" class="container mx-auto px-4 py-4">
  <h2 class="text-2xl md:text-3xl font-semibold">Galerie</h2>
  <div class="mt-8 grid grid-cols-2 md:grid-cols-3 gap-4">
    <%= image_tag 'salon-canape-hossegor.jpeg', class: 'w-full h-48 md:h-56 object-cover rounded-xl shadow', loading: 'lazy', alt: 'Salon lumineux' %>
    <%= image_tag 'terrasse-espace-detente-maison-hossegor-plage.jpeg', class: 'w-full h-48 md:h-56 object-cover rounded-xl shadow', loading: 'lazy', alt: 'Terasse spacieuse' %>
    <%= image_tag 'chambre-enfants-hossegor-angle-1.jpeg', class: 'w-full h-48 md:h-56 object-cover rounded-xl shadow', loading: 'lazy', alt: 'Chambre enfants' %>
    <%= image_tag 'cuisine-ouverte-espace-repas.jpeg', class: 'w-full h-48 md:h-56 object-cover rounded-xl shadow', loading: 'lazy', alt: 'Séjour cuisine salon lumineux' %>
    <%= image_tag 'terrasse-espace-repas-exterieur-maison-hossegor-lac-angle-1.jpeg', class: 'w-full h-48 md:h-56 object-cover rounded-xl shadow', loading: 'lazy', alt: 'Jardin clos et vaste terrasse' %>
    <%= image_tag 'terrasse-vue-globale-maison-hossegor-plage.jpeg', class: 'w-full h-48 md:h-56 object-cover rounded-xl shadow', loading: 'lazy', alt: 'Terrasse en bois avec mobilier de jardin barbecue et plancha' %>
  </div>

  <div class="mt-8">
    <%= link_to "Découvrir toutes les photos de la maison", gallery_path, class: "underline" %>
  </div>
</section>




<!-- BLOC CTA FINAL : RÉSERVATION EN DIRECT -->
<section class="bg-white py-12 md:py-16 px-4">
  <div class="mx-auto max-w-2xl text-center">

    <h2 class="text-2xl md:text-3xl font-semibold text-gray-900">
      Réservez en direct, au meilleur tarif
    </h2>

    <p class="mt-5 text-base text-gray-600 leading-relaxed">
      Profitez de notre maison à Hossegor à un tarif plus avantageux
      en réservant directement auprès de nous, sans frais de plateforme.
    </p>

    <p class="mt-4 text-sm md:text-base text-gray-600">
      Consultez les disponibilités sur Airbnb, puis contactez-nous
      pour organiser votre séjour.
    </p>

    <div class="mt-7 mx-auto max-w-md flex flex-col gap-3">

      <%= link_to contact_path,
          class: "flex items-center justify-center gap-3 rounded-xl bg-blue-950 px-5 py-4 text-base font-medium text-white hover:bg-blue-900 transition" do %>

        <svg xmlns="http://www.w3.org/2000/svg"
             width="20" height="20" viewBox="0 0 24 24"
             fill="none" stroke="currentColor" stroke-width="2"
             stroke-linecap="round" stroke-linejoin="round"
             aria-hidden="true">
          <rect x="2" y="4" width="20" height="16" rx="2"/>
          <path d="m22 7-10 6L2 7"/>
        </svg>

        <span>Nous contacter pour réserver</span>
      <% end %>

      <%= link_to "Voir les disponibilités sur Airbnb",
          "https://www.airbnb.fr/rooms/42052163",
          target: "_blank",
          rel: "noopener noreferrer",
          class: "block rounded-xl border border-gray-300 px-5 py-4 text-base font-medium text-gray-900 hover:bg-gray-50 transition" %>

    </div>

    <p class="mt-6 text-xs md:text-sm text-gray-500">
      Aucun paiement sur le site · Échange direct avec les propriétaires
    </p>

  </div>
</section>


