<!DOCTYPE html>
<html lang="fr">
  <head>
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-BBB6H57BP9"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-BBB6H57BP9');
    </script>
    
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <title><%= content_for?(:title) ? yield(:title) : "Maison Hossegor — Location saisonnière" %></title>
    <meta name="description" content="Maison de vacances à Soorts-Hossegor. 9 personnes, proche du centre, océan et lac parking, Wi‑Fi. Voir disponibilités et tarifs.">

    <meta property="og:type" content="website">
    <meta property="og:title" content="Maison Hossegor — Location saisonnière">
    <meta property="og:description" content="Maison de vacances à Soorts-Hossegor. 9 personnes, proche centre, océan et lac, parking, Wi‑Fi.">
    <meta property="og:image" content="<%= image_url('og-maison.jpg') rescue '' %>">
    <meta property="og:locale" content="fr_FR">

    <meta name="twitter:card" content="summary_large_image">

    <link rel="canonical" href="<%= request.original_url %>">

    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>
  <body class="min-h-screen flex flex-col bg-white text-gray-900">
    <!-- NAVBAR -->
    <header class="<%= current_page?(root_path) ? 'absolute inset-x-0 top-0 z-10 bg-transparent text-white' : 'relative z-10 bg-blue-950 text-white' %>">
      <nav class="container mx-auto px-4 py-4 relative flex items-center justify-between">

        <!-- Logo : centré sur mobile, à gauche sur ordinateur -->
        <%= link_to root_path,
            class: "absolute left-1/2 -translate-x-1/2 md:static md:translate-x-0" do %>
          <%= image_tag "Logo-thita-blanc.svg",
              alt: "THITA HOSSEGOR - Accueil",
              class: "w-44 md:w-84 h-auto" %>
        <% end %>

        <!-- Menu ordinateur -->
        <div class="hidden md:flex items-center gap-8">
          <%= link_to "Galerie", "/gallery",
              class: "text-lg font-medium hover:underline" %>

        <%= link_to "NOUS CONTACTER", contact_path,
            class: "rounded-full bg-blue-950 text-white px-6 py-3 font-medium hover:bg-blue-900 transition" %>
      </div>

      <!-- Menu mobile -->
      <div class="flex md:hidden items-center justify-between w-full">

        <details class="relative">
          <summary class="list-none cursor-pointer text-white text-2xl" aria-label="Ouvrir le menu">
            ☰
          </summary>

          <div class="absolute top-full left-0 mt-3 w-44 rounded-lg bg-blue-950 p-4 shadow-lg flex flex-col gap-4 text-white">
            <%= link_to "Galerie", "/gallery" %>
            <%= link_to "Nous contacter", contact_path %>
          </div>
        </details>

        <%= link_to contact_path, aria: { label: "Nous contacter" },
            class: "text-white text-2xl" do %>
          ✉
        <% end %>
      </div>        
      </nav>
    </header>

    <!-- CONTENU -->
    <main class="flex-1">
      <%= yield %>
    </main>

    <!-- FOOTER -->
    <footer class="border-t border-gray-100">
      <div class="container mx-auto px-4 py-8 grid md:grid-cols-3 gap-6 text-sm">
        <div>
          <p class="font-semibold">La maison de Thita</p>
          <p>Soorts-Hossegor (Landes)</p>
        </div>
        <div>
          <p class="font-semibold">Contact</p>
          <p>Email : <a class="underline" href="mailto:rougermck@gmail.com">rougermck@gmail.com</a></p>
        </div>
        <div>
          <p><a class="underline" href="/mentions">Mentions légales</a></p>
        </div>
      </div>
    </footer>
  </body>
</html>
